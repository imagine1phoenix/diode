COPILOT_PROVIDER='groq'
COPILOT_MODEL='qwen/qwen3.8-27b'
GROQ_API_KEY='your_groq_api_key_here'

# -----------------------------------------------------------------------------
# Server & Port Configuration (Optional - Defaults to 0.0.0.0:8000)
# -----------------------------------------------------------------------------
HOST='0.0.0.0'
PORT=8000
# SIH_DB_PATH='alerts.db'

# -----------------------------------------------------------------------------
# Real-Time Outbound Threat Notifications (Optional)
